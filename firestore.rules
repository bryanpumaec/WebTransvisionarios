rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /contact_requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'phone', 'comment', 'service', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.company is string && request.resource.data.company.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 255
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 30
        && request.resource.data.comment is string && request.resource.data.comment.size() > 0 && request.resource.data.comment.size() <= 1500
        && request.resource.data.service in ['logisticos', 'aduaneros', 'transitos', 'other']
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }
  }
}
